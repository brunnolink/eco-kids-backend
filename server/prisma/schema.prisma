generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum TrashType {
  PAPER
  PLASTIC
  GLASS
  METAL
  ORGANIC
}

model Item {
  id          String    @id @default(uuid())
  name        String
  image       String?
  trashType   TrashType 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt  

  events      EventGame[]
}

model Bin {
  id          String    @id @default(uuid())
  name       String
  trashType   TrashType
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events      EventGame[]
}
model Player {
  id    String  @id @default(uuid())
  name  String
  scores Score[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events  EventGame[]
}

model Score {
  id        String   @id @default(uuid())
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String
  points    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventGame {
  id          String    @id @default(uuid())
  player      Player    @relation(fields: [playerId], references: [id])
  playerId    String
  item        Item      @relation(fields: [itemId], references: [id])
  itemId      String
  bin         Bin       @relation(fields: [binId], references: [id])
  binId       String
  correct     Boolean
  createdAt   DateTime  @default(now())
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  description String
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}